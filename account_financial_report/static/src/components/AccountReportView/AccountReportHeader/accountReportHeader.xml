<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="account_financial_report.AccountReportHeader">
        <div
            class="border-bottom mt-3 mb-3 bg-white rounded shadow-sm p-3 d-flex align-items-center gap-3"
        >
            <div class="d-flex gap-2">
                <button
                    type="button"
                    class="btn btn-secondary"
                    title="Exportar PDF"
                    aria-label="Exportar PDF"
                    t-on-click="() => env.exportReport('pdf')"
                    t-att-disabled="env.exporting"
                >
                    <i class="fa fa-file-pdf-o me-2" aria-hidden="true" />
                    <span class="d-none d-md-inline">PDF</span>
                </button>
                <button
                    type="button"
                    class="btn btn-secondary"
                    title="Exportar XLSX"
                    aria-label="Exportar XLSX"
                    t-on-click="() => env.exportReport('xlsx')"
                    t-att-disabled="env.exporting"
                >
                    <i class="fa fa-file-excel-o me-2" aria-hidden="true" />
                    <span class="d-none d-md-inline">XLSX</span>
                </button>
            </div>
            <div class="flex-grow-1 text-center">
                <h2 class="h4 mb-1 fw-semibold">
                    <t t-out="report_name" />
                </h2>
                <div class="small text-muted">
                    <span t-out="company_name" />
                    <span class="mx-2">·</span>
                    <span t-out="currency_name" />
                </div>
            </div>
        </div>
    </t>
</templates>

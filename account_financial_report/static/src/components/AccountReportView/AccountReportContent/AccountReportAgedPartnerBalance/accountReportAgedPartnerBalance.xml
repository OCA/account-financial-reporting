<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="account_financial_report.AccountReportAgedPartnerBalance">
        <details
            t-foreach="rows"
            t-as="account"
            t-key="account.key"
            open="open"
            class="m-1 bg-white rounded shadow-sm p-3"
        >
            <summary class="fw-bold text-body text-break"><t
                t-out="account.account.code"
            /> — <t t-out="account.account.name" /></summary>
            <div class="table-responsive mt-3">
                <table
                    class="table caption-top table-hover align-middle text-nowrap mb-0"
                    t-att-aria-label="account.account.code + ' — ' + account.account.name"
                >
                    <thead class="table-light">
                        <tr>
                            <th t-foreach="columns" t-as="column" t-key="column.key">
                                <t t-out="column.label" />
                            </th>
                        </tr>
                    </thead>
                    <t t-if="options.showMoveLineDetails">
                        <tbody
                            t-foreach="account.partners"
                            t-as="partner"
                            t-key="partner.key"
                        >
                            <tr class="bg-body-tertiary">
                                <td
                                    t-att-colspan="isPartnerOpen(partner) ? columns.length : partnerLabelColspan"
                                >
                                    <button
                                        type="button"
                                        class="btn p-0 border-0 fw-bold text-body text-start"
                                        t-att-aria-expanded="isPartnerOpen(partner) ? 'true' : 'false'"
                                        t-on-click="() => this.togglePartner(partner)"
                                    >
                                        <i
                                            t-att-class="isPartnerOpen(partner) ? 'fa fa-caret-down me-2' : 'fa fa-caret-right me-2'"
                                            aria-hidden="true"
                                        />
                                        <t t-out="partner.name" />
                                    </button>
                                </td>
                                <AccountReportLines
                                    t-if="!isPartnerOpen(partner)"
                                    columns="partnerBalanceColumns"
                                    row="partner.total"
                                />
                            </tr>
                            <t t-if="isPartnerOpen(partner)">
                                <tr
                                    t-foreach="partner.moveLines"
                                    t-as="row"
                                    t-key="row.key"
                                >
                                    <AccountReportLines columns="columns" row="row" />
                                </tr>
                                <tr class="table-light border-top fw-bold">
                                    <AccountReportLines
                                        columns="columns"
                                        row="partner.total"
                                    />
                                </tr>
                            </t>
                        </tbody>
                    </t>
                    <tbody t-else="">
                        <tr t-foreach="account.partners" t-as="row" t-key="row.key">
                            <AccountReportLines columns="columns" row="row" />
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="border-top fw-bold">
                            <AccountReportLines columns="columns" row="account" />
                        </tr>
                        <tr>
                            <AccountReportLines
                                columns="percentageColumns"
                                row="account.percentages"
                            />
                        </tr>
                    </tfoot>
                </table>
            </div>
        </details>
        <p t-if="!rows.length" class="text-muted">No records found.</p>
    </t>
</templates>

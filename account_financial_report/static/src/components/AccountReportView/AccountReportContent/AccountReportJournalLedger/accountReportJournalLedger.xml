<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="account_financial_report.AccountReportJournalLedger">
        <details
            t-foreach="rows"
            t-as="journal"
            t-key="journal.key"
            open="open"
            class="m-1 bg-white rounded shadow-sm p-3"
        >
            <summary class="fw-bold text-body text-break">
                <t t-out="journal.name" />
            </summary>
            <div class="table-responsive mt-3">
                <table
                    class="table caption-top table-hover align-middle text-nowrap mb-0"
                    t-att-aria-label="journal.name"
                >
                    <thead class="table-light">
                        <tr>
                            <th t-foreach="columns" t-as="column" t-key="column.key">
                                <t t-out="column.label" />
                            </th>
                        </tr>
                    </thead>
                    <tbody t-foreach="journal.moves" t-as="move" t-key="move.key">
                        <tr class="bg-body-tertiary">
                            <td t-att-colspan="columns.length">
                                <button
                                    type="button"
                                    class="btn p-0 border-0 fw-bold text-body text-start"
                                    t-att-aria-expanded="isMoveOpen(move) ? 'true' : 'false'"
                                    t-on-click="() => this.toggleMove(move)"
                                >
                                    <i
                                        t-att-class="isMoveOpen(move) ? 'fa fa-caret-down me-2' : 'fa fa-caret-right me-2'"
                                        aria-hidden="true"
                                    />
                                    <t t-out="move.name" />
                                </button>
                            </td>
                        </tr>
                        <t t-if="isMoveOpen(move)">
                            <tr t-foreach="move.lines" t-as="row" t-key="row.key">
                                <AccountReportLines columns="columns" row="row" />
                            </tr>
                        </t>
                    </tbody>
                    <tfoot t-if="journal.total" class="table-light">
                        <tr class="border-top fw-bold">
                            <AccountReportLines columns="columns" row="journal.total" />
                        </tr>
                    </tfoot>
                </table>
            </div>
            <details t-if="journal.taxes.length" open="open" class="mt-3">
                <summary class="fw-bold text-body">Taxes summary</summary>
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle text-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th
                                    t-foreach="taxColumns"
                                    t-as="column"
                                    t-key="column.key"
                                >
                                    <t t-out="column.label" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="journal.taxes" t-as="row" t-key="row.key">
                                <AccountReportLines columns="taxColumns" row="row" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </details>
        </details>
        <p t-if="!rows.length" class="text-muted">No records found.</p>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="account_financial_report.AccountReportContent">
        <div class="d-flex flex-column flex-grow-1 overflow-hidden">
            <div class="flex-shrink-0">
                <AccountReportFilters env="env" />
            </div>
            <div
                class="d-flex justify-content-between align-items-center flex-shrink-0 my-2"
            >
                <button
                    t-if="filterByAccount"
                    type="button"
                    class="btn btn-secondary btn-sm"
                    t-on-click="toggleSidebar"
                    t-att-aria-expanded="sidebarOpen"
                >
                    <i class="fa fa-bars me-2" aria-hidden="true" />
                    Accounts
                </button>
                <div class="ms-auto">
                    <Pager
                        offset="pagination.offset"
                        limit="pagination.limit"
                        total="totalRows"
                        onUpdate.bind="onPagerUpdate"
                    />
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row flex-grow-1 overflow-hidden">
                <AccountReportSidebar
                    t-if="filterByAccount and sidebarOpen"
                    env="env"
                    onSelect.bind="onAccountPrefixSelect"
                />
                <div
                    class="flex-grow-1 overflow-auto p-2"
                    style="min-width: 0; min-height: 0;"
                >
                    <t t-component="component" t-props="{env: env}" />
                </div>
            </div>
        </div>
    </t>
</templates>

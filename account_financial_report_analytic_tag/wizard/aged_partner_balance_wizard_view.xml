<odoo>
    <record id="aged_partner_balance_wizard_analytic_tag" model="ir.ui.view">
        <field name="name">Aged Partner Balance - Analytic Tags</field>
        <field name="model">aged.partner.balance.report.wizard</field>
        <field
            name="inherit_id"
            ref="account_financial_report.aged_partner_balance_wizard"
        />
        <field name="arch" type="xml">
            <!-- Analytic Tags is only meaningful when move line details are shown -->
            <field name="show_analytic_distribution" position="after">
                <field
                    name="show_analytic_tags"
                    invisible="not show_move_line_details"
                />
            </field>
        </field>
    </record>
</odoo>

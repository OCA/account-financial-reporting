<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mis.builder.cash.flow.extended</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block title="Cash Flow Plan">
                    <setting
                        string="Max Forecast Lines"
                        help="Maximum number of forecast lines a Cash Flow Plan can generate at once when using 'Generate Forecast Lines'."
                    >
                        <field name="cash_flow_plan_max_forecast_lines" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

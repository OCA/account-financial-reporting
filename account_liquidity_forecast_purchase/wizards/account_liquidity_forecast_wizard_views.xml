<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_liquidity_forecast_wizard_inherit" model="ir.ui.view">
        <field name="name">Liquidity Forecast Wizard Inherit</field>
        <field name="model">account.liquidity.forecast.report.wizard</field>
        <field
            name="inherit_id"
            ref="account_liquidity_forecast.liquidity_forecast_wizard"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='target_move']" position="after">
                <field name="include_po_draft" />
            </xpath>
        </field>
    </record>

</odoo>

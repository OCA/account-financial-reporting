<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- The 'analytic' block requires account.group_account_user, a group that
                 nobody gets unless the enterprise accounting app is installed, so these
                 settings are placed in a block reachable by any accounting manager. -->
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting
                    id="stock_move_non_billed_threshold"
                    string="Non Billed Stock Moves"
                    help="Date from which stock movements are to be taken into account for the non billed movements report."
                >
                    <field name="stock_move_non_billed_threshold" />
                </setting>
                <setting
                    id="interval_restrict_invoices"
                    string="Non Billed Invoices Interval"
                    help="Restrict by default the invoices to the selected date interval in the non billed movements report."
                >
                    <field name="default_interval_restrict_invoices" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
